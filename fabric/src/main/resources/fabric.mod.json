{
  "schemaVersion": 1,
  "id": "knightlib",
  "version": "${version}",
  "name": "Knight Lib",
  "description": "A Minecraft library mod that serves as a bridge between mods.",
  "authors": [
    "Xylonity",
    "ModderG"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "GNU GPL v3.0",
  "icon": "assets/knightlib/icon.png",
    "environment": "*",
    "entrypoints": {
      "main": [
        "dev.xylonity.knightlib.KnightLib"
      ],
      "client": [
        "dev.xylonity.knightlib.KnightLib"
      ],
      "jei_mod_plugin": [
        "dev.xylonity.knightlib.compat.jei.KnightLibPlugin"
      ],
      "fabric-datagen": [
        "dev.xylonity.knightlib.datagen.KnightLibLootModifierGenerator"
      ]
    },
    "mixins": [
      "knightlib.mixins.json",
      "knightlib.fabric.mixins.json"
    ],
    "depends": {
      "fabricloader": ">=0.14",
      "fabric": "*",
      "minecraft": "1.19.x",
      "java": ">=17",
      "azurelib": "*"
    },
    "suggests": {
      "another-mod": "*"
    }
  }
  